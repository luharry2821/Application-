# Copy to .env (or just export these) before running.

# Required: your AssemblyAI key (https://www.assemblyai.com/dashboard/api-keys).
# Stays server-side; the browser never sees it.
ASSEMBLYAI_API_KEY=your_key_here

# Optional: "us" (default) or "eu" for data residency. If you set eu, also change
# WS_URL in voice-agent.html to wss://agents.eu.assemblyai.com/v1/ws.
SKYLINE_REGION=us

# Optional: where the Excel workbook lives (default ./data).
# SKYLINE_DATA_DIR=data
